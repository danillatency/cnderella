class Class is
    method isinstanceof(other: Class) => return systemclassname(this).equal(systemclassname(other))

    method print() => "root class".print()

    method print-line() => "root class".print-line()
end


class AnyValue : Class is
    method print() => "any value class".print()

    method print-line() => "any value class".print-line()
end


class Integer : AnyValue is
    var value := systemint(0)
    var min := systemminint()
    var max := systemmaxint()


    this() => "pass"

    this(literal: Integer) => this.value := literal.value

    this(literal: Float) => this.value := systemfloattoint(literal.value)


    method print() => systemprint(this.value)

    method print-line() is
        systemprint(this.value)
        '
'.print()
    end

    method to-float() => return Float(this)

    method to-boolean() => return Boolean(this.equal(0).not())

    method plus(other: Integer) is
        var temp := Integer()
        temp.value := systemintplus(this.value, other.value)
        return temp
    end

    method plus(other: Float) is
        var temp := Float()
        temp.value := systemfloatplus(Float(this).value, other.value)
        return temp
    end

    method multiply(other: Integer) is
        var temp := Integer()
        temp.value := systemintmul(this.value, other.value)
        return temp
    end

    method multiply(other: Float) is
        var temp := Float()
        temp.value := systemfloatmul(Float(this).value, other.value)
        return temp
    end

    method divide(other: Integer) is
        var temp := Integer()
        temp.value := systemintdiv(this.value, other.value)
        return temp
    end

    method divide(other: Float) is
        var temp := Float()
        temp.value := systemfloatdiv(Float(this).value, other.value)
        return temp
    end

    method remainder(other: Integer) is
        var temp := Integer()
        temp.value := systemintmod(this.value, other.value)
        return temp
    end

    method less(other: Integer) is
        var temp := Boolean()
        temp.value := systemintless(this.value, other.value)
        return temp
    end

    method less(other: Float) is
        var temp := Boolean()
        temp.value := systemfloatless(Float(this).value, other.value)
        return temp
    end

    method lessequal(other: Integer) is
        var temp := Boolean()
        temp.value := systemintlessequal(this.value, other.value)
        return temp
    end

    method lessequal(other: Float) is
        var temp := Boolean()
        temp.value := systemfloatlessequal(Float(this).value, other.value)
        return temp
    end

    method greater(other: Integer) is
        var temp := Boolean()
        temp.value := systemintgreater(this.value, other.value)
        return temp
    end

    method greater(other: Float) is
        var temp := Boolean()
        temp.value := systemfloatgreater(Float(this).value, other.value)
        return temp
    end

    method greaterequal(other: Integer) is
        var temp := Boolean()
        temp.value := systemintgreaterequal(this.value, other.value)
        return temp
    end

    method greaterequal(other: Float) is
        var temp := Boolean()
        temp.value := systemfloatgreaterequal(Float(this).value, other.value)
        return temp
    end

    method equal(other: Integer) is
        var temp := Boolean()
        temp.value := systemintequal(this.value, other.value)
        return temp
    end

    method equal(other: Float) is
        var temp := Boolean()
        temp.value := systemfloatequal(Float(this).value, other.value)
        return temp
    end
end


class Boolean : AnyValue is
    var value := systembool(false)


    this() => "pass"

    this(literal: Boolean) => this.value := literal.value


    method print() => systemprint(this.value)

    method print-line() is
        systemprint(this.value)
        '
'.print()
    end

    method to-integer() is
        if this then return 1 end
        return 0
    end

    method not() is
        var temp := Boolean()
        temp.value := systemnot(this.value)
        return temp
    end

    method and(other: Boolean) is
        var temp := Boolean()
        temp.value := systemnand(this.value, other.value)
        return temp
    end

    method or(other: Boolean) is
        var temp := Boolean()
        temp.value := systemor(this.value, other.value)
        return temp
    end
end


class Float : AnyValue is
    var value := systemfloat(0.0)
    var min := systemminfloat()
    var max := systemmaxfloat()


    this() => "pass"

    this(literal: Float) => this.value := literal.value

    this(literal: Integer) => this.value := systeminttofloat(literal.value)


    method print() => systemprint(this.value)

    method print-line() is
        systemprint(this.value)
        '
'.print()
    end

    method to-integer() => return Integer(this)

    method to-boolean() => return Boolean(this.equal(0.0).not())

    method plus(other: Integer) is
        var temp := Float()
        temp.value := systemfloatplus(this.value, Float(other).value)
        return temp
    end

    method plus(other: Float) is
        var temp := Float()
        temp.value := systemfloatplus(this.value, other.value)
        return temp
    end

    method multiply(other: Integer) is
        var temp := Float()
        temp.value := systemfloatmul(this.value, Float(other).value)
        return temp
    end

    method multiply(other: Float) is
        var temp := Float()
        temp.value := systemfloatmul(this.value, other.value)
        return temp
    end

    method divide(other: Integer) is
        var temp := Float()
        temp.value := systemfloatdiv(this.value, other.value)
        return temp
    end

    method divide(other: Float) is
        var temp := Float()
        temp.value := systemfloatdiv(this.value, other.value)
        return temp
    end

    method less(other: Integer) is
        var temp := Boolean()
        temp.value := systemfloatless(this.value, Float(other).value)
        return temp
    end

    method less(other: Float) is
        var temp := Boolean()
        temp.value := systemfloatless(this.value, other.value)
        return temp
    end

    method lessequal(other: Integer) is
        var temp := Boolean()
        temp.value := systemfloatlessequal(this.value, Float(other).value)
        return temp
    end

    method lessequal(other: Float) is
        var temp := Boolean()
        temp.value := systemfloatlessequal(this.value, other.value)
        return temp
    end

    method greater(other: Integer) is
        var temp := Boolean()
        temp.value := systemfloatgreater(this.value, Float(other).value)
        return temp
    end

    method greater(other: Float) is
        var temp := Boolean()
        temp.value := systemfloatgreater(this.value, other.value)
        return temp
    end

    method greaterequal(other: Integer) is
        var temp := Boolean()
        temp.value := systemfloatgreaterequal(this.value, Float(other).value)
        return temp
    end

    method greaterequal(other: Float) is
        var temp := Boolean()
        temp.value := systemfloatgreaterequal(this.value, other.value)
        return temp
    end

    method equal(other: Integer) is
        var temp := Boolean()
        temp.value := systemfloatequal(this.value, Float(other).value)
        return temp
    end

    method equal(other: Float) is
        var temp := Boolean()
        temp.value := systemfloatequal(this.value, other.value)
        return temp
    end
end


class Character : AnyValue is
    var value := systemcharacter('o')

    this() => "pass"

    this(literal: Character) => this.value := systemcharacter(literal.value)

    method print() => systemprint(this.value)

    method print-line() is
        systemprint(this.value)
        '
'.print()
    end
end


class AnyReference : Class is
    var length := Integer(0)
    var address := systemmaloc(0)

    this(length: Integer) is
        this.length := length
        this.address := systemmaloc(length.value)
    end

    method print() => "any reference class".print()

    method print-line() => "any reference class".print-line()
end


class ArrayOfIntegers : AnyReference is
    this(length: Integer) => base(length)


    method print() is
        '['.print()
        var i := 0
        while i.less(this.length) loop
            systemaccess(systemshift(this.address, i.value)).print()
            ", ".print()
            i := i.plus(1)
        end
        ']'.print()
    end

    method print-line() is
        this.print()
        '
'.print()
    end

    method get(shift: Integer) => return systemaccess(systemshift(this.address, shift.value))

    method set(shift: Integer, integer: Integer) => systemput(systemshift(this.address, shift.value), integer.value)
end


