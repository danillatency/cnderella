class Class is
    var dynamic_type := "Class"
    
    method same-dynamic-type(other: Class) => return this.dynamic_type.equal(other.dynamic_type)
    method print() => this.dynamic_type.print()
    method print-line() => this.dynamic_type.print-line()
end


class AnyValue : Class is
    var dynamic_type := "AnyValue"
end


class Integer : AnyValue is
    var dynamic_type := "Integer"
    var value := systemAllocateInteger()
    var min := systemMinimalInteger()
    var max := systemMaximalInteger()

    this() is end
    this(literal: Integer) => this.value := literal.value
    this(literal: Float) => this.value := systemFloatToInteger(literal.value)

    method print() => systemPrintInteger(this.value)
    method print-line() => systemPrintLineInteger(this.value)
    method to-float() => return Float(this)
    method to-boolean() => return Boolean(this.equal(Integer()).not())
    method plus(other: Integer) is
        var temp := Integer()
        temp.value := systemIntegerPlus(this.value, other.value)
        return temp
    end
    method plus(other: Float) is
        var temp := Float()
        temp.value := systemFloatPlus(Float(this).value, other.value)
        return temp
    end
    method multiply(other: Integer) is
        var temp := Integer()
        temp.value := systemIntegerMultiply(this.value, other.value)
        return temp
    end
    method multiply(other: Float) is
        var temp := Float()
        temp.value := systemFloatMultiply(Float(this).value, other.value)
        return temp
    end
    method divide(other: Integer) is
        var temp := Integer()
        temp.value := systemDivide(this.value, other.value)
        return temp
    end
    method divide(other: Float) is
        var temp := Float()
        temp.value := systemFloatDivide(Float(this).value, other.value)
        return temp
    end
    method remainder(other: Integer) is
        var temp := Integer()
        temp.value := systemModulo(this.value, other.value)
        return temp
    end
    method less(other: Integer) is
        var temp := Boolean()
        temp.value := systemIntegerLess(this.value, other.value)
        return temp
    end
    method less(other: Float) is
        var temp := Boolean()
        temp.value := systemFloatLess(Float(this).value, other.value)
        return temp
    end
    method less-equal(other: Integer) is
        var temp := Boolean()
        temp.value := systemIntegerLessEqual(this.value, other.value)
        return temp
    end
    method less-equal(other: Float) is
        var temp := Boolean()
        temp.value := systemFloatLessEqual(Float(this).value, other.value)
        return temp
    end
    method greater(other: Integer) is
        var temp := Boolean()
        temp.value := systemIntegerGreater(this.value, other.value)
        return temp
    end
    method greater(other: Float) is
        var temp := Boolean()
        temp.value := systemFloatGreater(Float(this).value, other.value)
        return temp
    end
    method greater-equal(other: Integer) is
        var temp := Boolean()
        temp.value := systemIntegerGreaterEqual(this.value, other.value)
        return temp
    end
    method greater-equal(other: Float) is
        var temp := Boolean()
        temp.value := systemFloatGreaterEqual(Float(this).value, other.value)
        return temp
    end
    method equal(other: Integer) is
        var temp := Boolean()
        temp.value := systemIntegerEqual(this.value, other.value)
        return temp
    end
    method equal(other: Float) is
        var temp := Boolean()
        temp.value := systemFloatEqual(Float(this).value, other.value)
        return temp
    end
end


class Boolean : AnyValue is
    var dynamic_type := "Boolean"
    var value := systemAllocateBoolean()

    this() is end
    this(literal: Boolean) => this.value := literal.value

    method print() => if this then "True".print() else "False".print() end
    method print-line() => if this then "True".print-line() else "False".print-line() end
    method to-integer() => if this then return Integer(1) else return Integer() end
    method not() is
        var temp := Boolean()
        temp.value := systemNot(this.value)
        return temp
    end
    method and(other: Boolean) is
        var temp := Boolean()
        temp.value := systemAnd(this.value, other.value)
        return temp
    end
    method or(other: Boolean) is
        var temp := Boolean()
        temp.value := systemOr(this.value, other.value)
        return temp
    end
end


class Float : AnyValue is
    var dynamic_type := "Float"
    var value := systemAllocateFloat()
    var min := systemMinimalFloat()
    var max := systemMaximalFloat()

    this() is end
    this(literal: Float) => this.value := literal.value
    this(literal: Integer) => this.value := systemIntegerToFloat(literal.value)

    method print() => systemPrintFloat(this.value)
    method print-line() => systemPrintLineFloat(this.value)
    method to-integer() => return Integer(this)
    method to-boolean() => return Boolean(this.equal(Float()).not())
    method plus(other: Integer) is
        var temp := Float()
        temp.value := systemFloatPlus(this.value, Float(other).value)
        return temp
    end
    method plus(other: Float) is
        var temp := Float()
        temp.value := systemFloatPlus(this.value, other.value)
        return temp
    end
    method multiply(other: Integer) is
        var temp := Float()
        temp.value := systemFloatMultiply(this.value, Float(other).value)
        return temp
    end
    method multiply(other: Float) is
        var temp := Float()
        temp.value := systemFloatMultiply(this.value, other.value)
        return temp
    end
    method divide(other: Integer) is
        var temp := Float()
        temp.value := systemFloatDivide(this.value, other.value)
        return temp
    end
    method divide(other: Float) is
        var temp := Float()
        temp.value := systemFloatDivide(this.value, other.value)
        return temp
    end
    method less(other: Integer) is
        var temp := Boolean()
        temp.value := systemFloatLess(this.value, Float(other).value)
        return temp
    end
    method less(other: Float) is
        var temp := Boolean()
        temp.value := systemFloatLess(this.value, other.value)
        return temp
    end
    method less-equal(other: Integer) is
        var temp := Boolean()
        temp.value := systemFloatLessEqual(this.value, Float(other).value)
        return temp
    end
    method less-equal(other: Float) is
        var temp := Boolean()
        temp.value := systemFloatLessEqual(this.value, other.value)
        return temp
    end
    method greater(other: Integer) is
        var temp := Boolean()
        temp.value := systemFloatGreater(this.value, Float(other).value)
        return temp
    end
    method greater(other: Float) is
        var temp := Boolean()
        temp.value := systemFloatGreater(this.value, other.value)
        return temp
    end
    method greater-equal(other: Integer) is
        var temp := Boolean()
        temp.value := systemFloatGreaterEqual(this.value, Float(other).value)
        return temp
    end
    method greater-equal(other: Float) is
        var temp := Boolean()
        temp.value := systemFloatGreaterEqual(this.value, other.value)
        return temp
    end
    method equal(other: Integer) is
        var temp := Boolean()
        temp.value := systemFloatEqual(this.value, Float(other).value)
        return temp
    end
    method equal(other: Float) is
        var temp := Boolean()
        temp.value := systemFloatEqual(this.value, other.value)
        return temp
    end
end


class Character : AnyValue is
    var dynamic_type := "Character"
    var value := systemAllocateCharacter()

    this() is end
    this(literal: Character) => this.value := literal.value

    method print() => systemPrintCharacter(this.value)
    method print-line() => systemPrintLineCharacter(this.value)
end


class AnyReference : Class is
    var dynamic_type := "AnyReference"
    var length := Integer()
    var memory := systemAllocateMemory()
end


class AnyArray : AnyReference is
    var dynamic_type := "AnyArray"

    this(length: Integer) => this.memory := systemAllocateMemory(length.value)

    method print() is
        '['.print()
        var i := 0
        while i.less(this.length) loop
            systemShiftMemory(this.memory, i.value).print()
            ", ".print()
            i := i.plus(1)
        end
        ']'.print()
    end
    method print-line() is
        this.print()
        '
'.print()
    end
end


class ArrayOfIntegers : AnyReference is
    var dynamic_type := "ArrayOfIntegers"

    this(length: Integer) => base(length)
    
    method get(shift: Integer) : Integer => return systemShiftMemory(this.address, shift.value)
    method set(shift: Integer, integer: Integer) => systemShiftMemory(this.address, shift.value) := integer
end


class ArrayOfBooleans : AnyReference is
    var dynamic_type := "ArrayOfBooleans"

    this(length: Integer) => base(length)
    
    method get(shift: Integer) : Boolean => return systemShiftMemory(this.address, shift.value)
    method set(shift: Integer, boolean: Boolean) => systemShiftMemory(this.address, shift.value) := boolean
end


class ArrayOfFloats : AnyReference is
    var dynamic_type := "ArrayOfFloats"

    this(length: Integer) => base(length)
    
    method get(shift: Integer) : Float => return systemShiftMemory(this.address, shift.value)
    method set(shift: Integer, float: Float) => systemShiftMemory(this.address, shift.value) := float
end


class ArrayOfCharacters : AnyReference is
    var dynamic_type := "ArrayOfCharacters"

    this(length: Integer) => base(length)
    
    method get(shift: Integer) : Character => return systemShiftMemory(this.address, shift.value)
    method set(shift: Integer, character: Character) => systemShiftMemory(this.address, shift.value) := character
end


class AnyList : AnyReference is
    var dynamic_type := "AnyList"
    var next_list := AnyList()

    method print() is
        '{'.print()
        if this.length.equal(Integer()).not() then
            this.memory.print()
            var next := this.next_list
            while next.is-nothing().not() loop
                next.memory.print()
                ", ".print()
                next := next.next_list
            end
            '}'.print()
        end
        '}'.print()
    end
    method print-line() is
        this.print()
        '
'.print()
    end
    method is-nothing() is
        var temp := Boolean()
        if this.length.equal(Integer()) then temp.not() else temp end
    end
end


class ListOfIntegers : AnyReference is
    var dynamic_type := "ListOfIntegers"

    this() is end

    method append(integer: Integer) =>
        if this.length.equal(Integer()) then
            this.length := 1
            this.memory := integer
            this.next_list := ListOfIntegers()
        else
            this.length := this.length.plus(1)
            var next := this.next_list
            while next.is-nothing().not() loop
                next.length := next.length.plus(1)
                next := next.next_list
            end
            next.append(integer)
        end

    method head(): Integer => return this.memory

    method tail(): ListOfIntegers => return this.next_list
end


class ListOfBooleans : AnyReference is
    var dynamic_type := "ListOfBooleans"

    this() is end

