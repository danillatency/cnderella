class ListOfIntegers : AnyReference is
    var next_list := AnyReference()

    method print() is
        '{'.print()
        if this.length.equal(0).not() then
            systemaccess(this.address).print()
            var next := this.next_list
            while next.isinstanceof(ListOfIntegers()).not() loop
                systemaccess(next.address).print()
                ", ".print()
                next := next.next_list
            end
            '}'.print()
        end
        '}'.print()
    end

    method print-line() is
        this.print()
        '
'.print()
    end

    method append(integer: Integer) =>
        if this.length.equal(0) then
            base(1)
            this.length := 1
            this.address := systempointer(integer)
        else
            this.length := this.length.plus(1)
            var next := this.next_list
            while next.isinstanceof(AnyReference()).not() loop
                next.length := next.length.plus(1)
                next := next.next_list
            end
            var new_elem := ListOfIntegers()
            new_elem.append(integer)
            next.next_list := new_elem
        end

    method head(): Integer => return systemaccess(this.address)

    method tail() => this.next_list
end


