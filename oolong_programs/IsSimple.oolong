class IsSimple is
    this(number: Integer) => this.is-simple(number).print-line()

    method is-simple(number: Integer) is
        var i := number.plus(-1)
        while i.greater(1) loop
            if number.remainder(i).equal(0) then
                return false
            else
                i := i.plus(-1)
            end
        end
        return true
    end
end